# ============================================================================
# Variables locales del stack geolocaACB (Compose).
# Copiar a ".env" y completar los secretos antes de habilitar control/lectura.
# El archivo ".env" NO se versiona (ver .gitignore).
# ============================================================================

# --- Puertos publicados en el host ---
# GPS queda en localhost:8079; el contenedor escucha en 8080.
GPS_HOST_PORT=8079
GPS_HTTP_PORT=8080
# Paths (Python) queda en localhost:8000.
# (Definido en docker-compose.yml; se documenta aquí como referencia.)

# --- Integracion GPS -> API Gateway ---
# El GPS solo habla con otros componentes a traves del Gateway.
GPS_GATEWAY_BASE_URL=http://api-gateway:5062
GPS_GATEWAY_ROUTES_PATH=/api/v1/routes/{route_id}
# Opcional: solo si se acuerda autenticacion de servicio para la salida a Gateway.
GPS_GATEWAY_ROUTES_TOKEN=

# --- Habilitacion de APIs de control y lectura del GPS ---
GPS_CONTROL_API_ENABLED=true
GPS_READ_API_ENABLED=true
# Catalogo YAML montado por acb_gps_lo/compose.yaml. El ejemplo incluido es
# sintetico y no autoriza recorridos reales.
GPS_POLICIES_FILE=/etc/acb-gps/tracking-policies.yaml

# --- Secretos de servicio (NO versionar valores reales) ---
# Generar cada uno con 32-64 bytes aleatorios codificados en base64url sin
# padding, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Deben ser valores DISTINTOS.
#
# GPS_GATEWAY_INTERNAL_TOKEN se comparte con el Gateway como GPS_INTERNAL_TOKEN.
GPS_GATEWAY_INTERNAL_TOKEN=
# Clave de derivacion HMAC del Bearer de observacion (solo GPS).
GPS_CONTROL_CREDENTIAL_KEY=

# --- Ventanas y limites (valores por defecto del componente) ---
GPS_CONTROL_ISSUANCE_WINDOW=10m
GPS_CONTROL_REQUEST_TIMEOUT=5s
GPS_READ_MAX_PAGE_LIMIT=100
GPS_READ_MAX_RESPONSE_BYTES=1048576
GPS_READ_REQUEST_TIMEOUT=5s

# --- Despacho a Operaciones (sigue apagado) ---
GPS_OPERATIONS_DELIVERY_ENABLED=false
