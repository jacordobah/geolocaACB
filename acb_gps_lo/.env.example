# Puertos de desarrollo. Redis no publica un puerto en el host.
GPS_HTTP_PORT=8080
GPS_HOST_PORT=8081
GPS_REDIS_ADDR=redis:6379
GPS_REDIS_DIAL_TIMEOUT=2s
GPS_REDIS_PING_TIMEOUT=1s
GPS_SHUTDOWN_TIMEOUT=20s

# Origen único del API Gateway. Rutas absolutas acordadas con su equipo.
# Ejemplos sintéticos: https://gateway.example.test y /paths/api/v1/routes/{route_id}
GPS_GATEWAY_BASE_URL=
GPS_GATEWAY_ROUTES_PATH=
GPS_GATEWAY_ROUTES_TOKEN=
GPS_GATEWAY_EVENTS_PATH=
GPS_PATHS_HTTP_TIMEOUT=3s
GPS_PATHS_MAX_RESPONSE_BYTES=2097152

# Conservacion minima por posicion; el margen absorbe desfases de reloj.
GPS_POSITION_RETENTION=24h
GPS_POSITION_SAFETY_MARGIN=5m
GPS_MAX_OBSERVATION_AGE=15m
GPS_FUTURE_SKEW=30s
GPS_MAX_OBSERVATION_BYTES=4096
GPS_REQUEST_TIMEOUT=5s

# La API de control permanece deshabilitada hasta acordar identidad y politicas.
GPS_CONTROL_API_ENABLED=false
# Optativo. El ejemplo montado es sintetico y no autoriza sesiones reales.
# GPS_POLICIES_FILE=/etc/acb-gps/tracking-policies.yaml
GPS_READ_MAX_PAGE_LIMIT=100
GPS_READ_MAX_RESPONSE_BYTES=1048576
GPS_READ_REQUEST_TIMEOUT=5s

# Recuperacion de planes incompletos, independiente de Operaciones.
GPS_RECOVERY_POLL=2s
# Contrato HTTP provisional: habilitar solo tras acordarlo con Operaciones.
GPS_OPERATIONS_DELIVERY_ENABLED=false
GPS_OPERATIONS_TOKEN=
GPS_OPERATIONS_HTTP_TIMEOUT=3s
GPS_OPERATIONS_MAX_RESPONSE_BYTES=4096
GPS_OUTBOX_WORKERS=2
GPS_OUTBOX_POLL=1s
GPS_OUTBOX_LEASE=10s
GPS_OUTBOX_RETRY_MIN=5s
GPS_OUTBOX_RETRY_MAX=30m
GPS_OUTBOX_MAX_PER_HOUR=60
# Retencion tecnica provisional del sobre y acuse tras entrega confirmada.
GPS_OUTBOX_DELIVERED_RETENTION=168h

# Valor solamente para pruebas iniciales; dimensionar con carga GPS real.
REDIS_MAXMEMORY=512mb
# AOF sincronizado por escritura; medir su coste antes de cambiarlo.
REDIS_AOF_FSYNC=always
