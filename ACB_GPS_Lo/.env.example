# Puertos de desarrollo. Redis no publica un puerto en el host.
GPS_HTTP_PORT=8080
GPS_HOST_PORT=8081
GPS_REDIS_ADDR=redis:6379
GPS_REDIS_DIAL_TIMEOUT=2s
GPS_REDIS_PING_TIMEOUT=1s
GPS_SHUTDOWN_TIMEOUT=20s

# Valor solamente para pruebas iniciales; dimensionar con carga GPS real.
REDIS_MAXMEMORY=512mb
# AOF sincronizado por escritura; medir su coste antes de cambiarlo.
REDIS_AOF_FSYNC=always
